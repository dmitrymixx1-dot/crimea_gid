# Прод-конфигурация «Крым.Гид» для docker compose.
# Скопируйте в .env и заполните: cp .env.example .env
# Файл .env в репозиторий не коммитится (см. .gitignore).

# Домен, на который указывает A/AAAA-запись сервера. Обязателен:
# по нему Caddy выпускает сертификат, из него собирается og:url.
DOMAIN=gid.example.ru

# Почта для Let's Encrypt (уведомления об истечении сертификата).
ACME_EMAIL=admin@example.ru

# --- необязательные ручки (значения по умолчанию совпадают с config.py) ---

# Кэш ленты новостей, секунды.
NEWS_CACHE_TTL=900

# Кэш погоды, секунды.
WEATHER_TTL=3600

# Кому разрешено встраивать приложение в iframe.
# 'self' — только свой домен; * — всем (витрины, превью).
CSP_FRAME_ANCESTORS='self'
