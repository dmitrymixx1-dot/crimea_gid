# Прод-конфигурация «Крым.Гид» для docker compose.
# Скопируйте в .env и заполните: cp .env.example .env
# Файл .env в репозиторий не коммитится (см. .gitignore).

# Домен, на который указывает A/AAAA-запись сервера. Обязателен:
# по нему Caddy выпускает сертификат, из него собирается og:url.
DOMAIN=gid.example.ru

# Почта для Let's Encrypt (уведомления об истечении сертификата).
ACME_EMAIL=admin@example.ru

# --- необязательные ручки (значения по умолчанию совпадают с config.py) ---

# Кэш ленты новостей, секунды.
NEWS_CACHE_TTL=900

# Кэш погоды, секунды.
WEATHER_TTL=3600

# Кэш моря (вода и волна), секунды: модель обновляют реже погоды.
MARINE_TTL=10800

# Кому разрешено встраивать приложение в iframe.
# 'self' — только свой домен; * — всем (витрины, превью).
CSP_FRAME_ANCESTORS='self'

# Лимиты на дорогие ручки: квиз и принудительное обновление (refresh=1).
# Счётчики в памяти процесса; 0 — выключить лимиты (бэнчмарки, тесты).
RATE_LIMIT_ENABLED=1
# Квиз: расчётов в минуту на клиента.
RATE_LIMIT_QUIZ=30
# refresh=1 у ленты/погоды/моря: сколько раз за RATE_LIMIT_REFRESH_WINDOW.
RATE_LIMIT_REFRESH=6
RATE_LIMIT_REFRESH_WINDOW=300

# Доверять X-Forwarded-For: за Caddy там реальный адрес клиента.
# 0 — считать адрес соединения (приложение без прокси наружу).
TRUST_PROXY=1
